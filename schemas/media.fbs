namespace CoprocessorProto.Media;

// Playback state of a media renderer
enum TransportState : ubyte {
    Stopped = 0,
    Playing = 1,
    Paused = 2,
    Transitioning = 3,
}

// Media transport action to execute on a renderer
enum ActionType : ubyte {
    Play = 0,
    Pause = 1,
    TogglePlayPause = 2,
    Next = 3,
    Previous = 4,
    Stop = 5,
}

// Command from Host to Co-processor to perform a media transport action.
// Transport commands must target the group coordinator, not an arbitrary member.
table Action {
    endpoint_ip: string;
    endpoint_port: uint16 = 1400;
    action: ActionType;
}

// Command to set or adjust volume on a renderer.
// Volume is per-device: target any member, not necessarily the coordinator.
table VolumeCommand {
    endpoint_ip: string;
    endpoint_port: uint16 = 1400;
    volume: int16;        // 0..100 for absolute, or signed delta if is_relative
    is_relative: bool;    // If true, volume is treated as signed delta
}

// Command to subscribe to GENA events on a specific coordinator endpoint.
// Only one coordinator is subscribed at a time (the user-selected group);
// the host sends UnsubscribeAll + Subscribe when switching groups.
table Subscribe {
    endpoint_ip: string;
    endpoint_port: uint16 = 1400;
}

// Command to unsubscribe from all active GENA subscriptions
table UnsubscribeAll {}

// Command to discover/refresh topology using a seed IP.
// Never triggers subscriptions implicitly.
table GetTopology {
    seed_ip: string;
    seed_port: uint16 = 1400;
}

// Track metadata
table TrackMetadata {
    title: string;
    artist: string;
    album: string;
    duration_seconds: uint32 = null;
    elapsed_seconds: uint32 = null;
}

// Current media state update pushed from Co-processor to Host.
// Fields are optional because GENA events are partial: AVTransport events
// carry transport state + track, RenderingControl events carry volume + mute.
// The host merges updates keyed by endpoint_ip; absent fields keep old values.
table StateUpdate {
    endpoint_ip: string;
    transport_state: TransportState = null;
    volume: uint8 = null;
    is_muted: bool = null;
    track: TrackMetadata;
}

// Discovered speaker member in a zone group
table Member {
    name: string;
    uuid: string;
    ip: string;
}

// Discovered group/room in the household.
// `id` identifies a specific group configuration: it changes whenever the
// group is reconfigured (members join/leave), so the host can detect changes
// and merge updates per group without a separate revision counter.
table Group {
    id: string;
    name: string;
    coordinator_ip: string;
    coordinator_port: uint16 = 1400;
    is_playing: bool;
    members: [Member];
}

// Household topology update pushed from Co-processor to Host
table TopologyUpdate {
    groups: [Group];
}
