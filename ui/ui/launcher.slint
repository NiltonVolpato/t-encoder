// The launcher carousel.
//
// Contrast with the embedded-graphics version this replaces: the slide is one
// `animate` block rather than a hand-rolled fixed-point Tween plumbed through
// the router, and card placement is a `for` over a model rather than
// hand-computed centre-x arithmetic.

export struct CardData {
    name: string,
    accent: color,
    // Index into `Icons.all`. Comes from `Manifest.icon` on the Rust side.
    icon: int,
}

// App icons, rasterized from SVG at build time by resvg on the host — so the
// device only ever blits an anti-aliased bitmap, with no SVG parsing and no
// runtime cost. Adding an icon is one entry here plus the matching `IconId`.
export global Icons {
    out property <[image]> all: [
        @image-url("assets/tomato.svg"),
        @image-url("assets/macropad.svg"),
        @image-url("assets/simon.svg"),
        @image-url("assets/magic8.svg"),
    ];
}

// Distance between adjacent card centres. One source of truth for the strip.
export global Layout {
    out property <length> pitch: 210px;
    out property <length> card-w: 180px;
    out property <length> card-h: 200px;
}

component Card inherits Rectangle {
    in property <CardData> data;
    in property <bool> focused;

    width: focused ? Layout.card-w : 140px;
    height: focused ? Layout.card-h : 160px;
    y: (Layout.card-h - self.height) / 2;
    border-radius: 24px;
    background: data.accent.darker(0.88);
    border-width: focused ? 3px : 1px;
    border-color: focused ? data.accent : data.accent.darker(0.55);

    // Unfocused cards recede and shrink, giving a circular wheel depth illusion.
    opacity: focused ? 1.0 : 0.40;
    animate opacity, border-color, width, height { duration: 250ms; easing: ease-out; }

    VerticalLayout {
        padding: focused ? 26px : 18px;
        spacing: focused ? 14px : 10px;
        alignment: center;

        // The icon needs its own HorizontalLayout: a fixed-width child of a
        // VerticalLayout is left-aligned, not centred, which is what made the
        // placeholder discs sit off-centre.
        HorizontalLayout {
            alignment: center;
            Image {
                width: focused ? 88px : 68px;
                height: focused ? 88px : 68px;
                source: Icons.all[data.icon];
                image-fit: contain;
                animate width, height { duration: 250ms; easing: ease-out; }
            }
        }

        Text {
            text: data.name;
            color: white;
            font-size: focused ? 26px : 20px;
            horizontal-alignment: center;
        }
    }
}

export component Launcher inherits Rectangle {
    in property <[CardData]> cards;
    in property <int> selected: 0;

    background: transparent;

    // The whole strip translates; the eased `animate` here is the entire
    // carousel transition.
    Rectangle {
        y: (parent.height - Layout.card-h) / 2;
        height: Layout.card-h;
        x: (parent.width - Layout.card-w) / 2 - selected * Layout.pitch;
        animate x { duration: 250ms; easing: ease-out; }

        for card[i] in cards: Card {
            x: i * Layout.pitch + (Layout.card-w - self.width) / 2;
            data: card;
            focused: i == selected;
        }
    }

    // Page dots.
    HorizontalLayout {
        y: parent.height - 46px;
        height: 8px;
        spacing: 10px;
        alignment: center;

        for card[i] in cards: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: i == selected ? white : #202a20;
            animate background { duration: 200ms; }
        }
    }
}
