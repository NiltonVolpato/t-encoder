// Root component: the single Slint window for the whole device.
//
// One tree, one runtime, one font set — every app contributes a component here
// rather than linking its own renderer. `view` selects what is on screen; apps
// drive their own properties and Slint repaints what changed.

import { Launcher, CardData } from "launcher.slint";
import { Pomodoro, PomodoroState } from "apps/pomodoro.slint";
import { Macropad, MacropadState } from "apps/macropad.slint";
import { Simon, SimonState } from "apps/simon.slint";
import { Magic8, Magic8State } from "apps/magic8.slint";
import { Sonos, SonosState, SonosGroupCard } from "apps/sonos.slint";

export { CardData, PomodoroState, MacropadState, SimonState, Magic8State, SonosState, SonosGroupCard }

// Which screen is live: `launcher::ViewId`, published verbatim by the host.
// 0 is the launcher; every app claims its own id in its `Manifest`. An int
// rather than an enum so the host never learns one app from another — adding
// an app is an arm here, not a match arm in `main.rs`. Same shape as `IconId`
// indexing `Icons.all`.
export global Views {
    out property <int> launcher: 0;
    out property <int> pomodoro: 1;
    out property <int> macropad: 2;
    out property <int> simon: 3;
    out property <int> magic8: 4;
    out property <int> sonos: 5;
}

export component Shell inherits Window {
    // The board is a 390x390 round AMOLED.
    width: 390px;
    height: 390px;
    // True black is free on AMOLED and makes the accents pop.
    background: #000000;

    in property <int> view: Views.launcher;

    // Launcher state.
    in property <[CardData]> cards;
    in property <int> selected: 0;

    // Per-app state. Each app owns one property here and pushes to it; adding
    // an app is one property, one import and one `if` arm.
    in property <PomodoroState> pomodoro;
    in property <MacropadState> macropad;
    in property <SimonState> simon;
    in property <Magic8State> magic8;
    in property <SonosState> sonos;

    if view == Views.launcher: Launcher {
        width: parent.width;
        height: parent.height;
        cards: root.cards;
        selected: root.selected;
    }

    if view == Views.pomodoro: Pomodoro {
        width: parent.width;
        height: parent.height;
        state: root.pomodoro;
    }

    if view == Views.macropad: Macropad {
        width: parent.width;
        height: parent.height;
        state: root.macropad;
    }

    if view == Views.simon: Simon {
        width: parent.width;
        height: parent.height;
        state: root.simon;
    }

    if view == Views.magic8: Magic8 {
        width: parent.width;
        height: parent.height;
        state: root.magic8;
    }

    if view == Views.sonos: Sonos {
        width: parent.width;
        height: parent.height;
        state: root.sonos;
    }
}
