// Sonos Controller for LilyGo T-Encoder-Pro (390x390 round AMOLED).

import { ArcSegment, RingData } from "ring.slint";

export struct SonosGroupCard {
    name: string,
    members: [string],
    playing_summary: string,
    is_playing: bool,
}

export struct SonosState {
    mode: int, // 0 = Group Selector, 1 = Now Playing
    groups: [SonosGroupCard],
    selected_group: int,
    active_group_name: string,
    track_title: string,
    track_artist: string,
    track_album: string,
    remaining_str: string,
    progress_ratio: float, // 0.0 .. 1.0
    volume: int, // 0 .. 100
    volume_visible: bool,
    is_playing: bool,
    accent: color,
    status: string,
}

component MarqueeText inherits Rectangle {
    in property <string> text;
    in property <color> text_color: #ffffff;
    in property <length> font_size: 24px;
    in property <int> font_weight: 800;

    clip: true;

    private property <length> text_width: txt.preferred-width;
    private property <length> max_scroll: max(0px, text_width - self.width);
    private property <bool> overflow: max_scroll > 0px;
    private property <length> offset: 0px;

    animate offset {
        duration: max(2s, max_scroll / 30px * 1s);
        delay: 1.5s;
        iteration-count: -1;
        direction: alternate;
        easing: linear;
    }

    init => {
        if self.overflow {
            self.offset = self.max_scroll;
        }
    }

    changed text => {
        self.offset = 0px;
        if self.overflow {
            self.offset = self.max_scroll;
        }
    }

    txt := Text {
        x: root.overflow ? -root.offset : 0px;
        width: root.overflow ? self.preferred-width : parent.width;
        horizontal-alignment: root.overflow ? left : center;
        text: root.text;
        color: root.text_color;
        font-size: root.font_size;
        font-weight: root.font_weight;
    }
}

component EqualizerBar inherits Rectangle {
    in property <length> min_h: 8px;
    in property <length> max_h: 44px;
    in property <duration> anim_duration: 400ms;
    in property <color> bar_color: #F87000;

    width: 8px;
    border-radius: 4px;
    background: root.bar_color;

    private property <length> h: min_h;
    height: h;

    animate h {
        duration: root.anim_duration;
        iteration-count: -1;
        direction: alternate;
        easing: ease-in-out;
    }

    init => {
        self.h = root.max_h;
    }
}

component AudioEqualizer inherits Rectangle {
    in property <color> bar_color: #F87000;
    width: 50px;
    height: 50px;

    HorizontalLayout {
        alignment: space-around;
        padding: 0px;
        spacing: 4px;

        VerticalLayout {
            alignment: end;
            EqualizerBar {
                bar_color: root.bar_color;
                min_h: 10px;
                max_h: 46px;
                anim_duration: 480ms;
            }
        }
        VerticalLayout {
            alignment: end;
            EqualizerBar {
                bar_color: root.bar_color;
                min_h: 8px;
                max_h: 34px;
                anim_duration: 350ms;
            }
        }
        VerticalLayout {
            alignment: end;
            EqualizerBar {
                bar_color: root.bar_color;
                min_h: 14px;
                max_h: 50px;
                anim_duration: 570ms;
            }
        }
        VerticalLayout {
            alignment: end;
            EqualizerBar {
                bar_color: root.bar_color;
                min_h: 10px;
                max_h: 40px;
                anim_duration: 410ms;
            }
        }
    }
}

export component Sonos inherits Rectangle {
    in property <bool> DEBUG;
    in-out property <SonosState> state;

    background: #000000;
    width: 390px;
    height: 390px;
    border-radius: DEBUG ? self.width / 2 : 0;
    clip: DEBUG ? true : false;

    forward-focus: focus-scope;
    focus-scope := FocusScope {
        key-pressed(event) => {
            if !root.DEBUG {
                return reject;
            }
            if event.text == Key.LeftArrow {
                root.state.selected_group = max(0, root.state.selected_group - 1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.state.selected_group = min(root.state.groups.length - 1, root.state.selected_group + 1);
                return accept;
            }
            if event.text == Key.Return {
                root.state.mode = root.state.mode == 0 ? 1 : 0;
                return accept;
            }
            if event.text == Key.Escape || event.text == Key.UpArrow {
                root.state.mode = 0;
                return accept;
            }
            if event.text == Key.DownArrow {
                root.state.mode = 1;
                return accept;
            }
            if event.text == " " {
                root.state.is_playing = !root.state.is_playing;
                return accept;
            }
            reject
        }
    }

    if root.DEBUG: TouchArea {
        scroll-event(event) => {
            if event.delta-y < 0px {
                root.state.selected_group = min(root.state.groups.length - 1, root.state.selected_group + 1);
            }
            if event.delta-y > 0px {
                root.state.selected_group = max(0, root.state.selected_group - 1);
            }
            accept
        }
    }

    // =========================================================================
    // Mode 0: Speaker Group Selector (Level 1 - Full Screen per Group)
    // =========================================================================
    if state.mode == 0: Rectangle {
        // Top Category Header
        Text {
            y: 42px;
            width: parent.width;
            text: "SONOS GROUPS";
            color: #718096;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            horizontal-alignment: center;
        }

        // Carousel strip: translates horizontally as selected_group changes
        Rectangle {
            width: parent.width;
            height: parent.height;
            x: - state.selected_group * parent.width;
            animate x { duration: 250ms; easing: ease-out; }

            for group[i] in state.groups: Rectangle {
                x: i * parent.width;
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    y: 90px;
                    x: 35px;
                    width: parent.width - 70px;
                    height: 210px;
                    alignment: center;
                    spacing: 12px;

                    // Member Rooms List
                    for member in group.members: Text {
                        width: parent.width;
                        text: member;
                        color: #a0aec0;
                        font-size: 26px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        overflow: elide;
                    }

                    // Now Playing Status Pill
                    Rectangle {
                        height: 40px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: center;

                            Text {
                                text: (group.is_playing ? "▶  " : "") + (group.playing_summary != "" ? group.playing_summary : "Not Playing");
                                color: group.is_playing ? state.accent : #a0aec0;
                                font-size: 16px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        // Bottom Page Indicator Dots
        HorizontalLayout {
            y: 318px;
            alignment: center;
            spacing: 8px;

            for group[i] in state.groups: Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: i == state.selected_group ? state.accent : #ffffff.with-alpha(0.3);
                animate background { duration: 180ms; easing: ease-out; }

                if root.DEBUG: TouchArea {
                    clicked => { root.state.selected_group = i; }
                }
            }
        }

        // Bottom Navigation Hint
        Text {
            y: 344px;
            width: parent.width;
            text: "PRESS TO CONTROL";
            color: #718096;
            font-size: 14px;
            font-weight: 500;
            horizontal-alignment: center;

            if root.DEBUG: TouchArea {
                clicked => { root.state.mode = 1; }
            }
        }
    }

    // =========================================================================
    // Mode 1: Now Playing (Level 2 - Option A Layout)
    // =========================================================================
    if state.mode == 1: Rectangle {
        Image {
            source: @image-url("../assets/album-art-mock.png");
            width: 100%;
            height: 100%;
        }

        // Dark scrim overlay for high contrast readability
        Rectangle {
            width: 100%;
            height: 100%;
            background: #000000.with-alpha(0.35);
        }

        // 1. Static full-screen background ring
        Image {
            source: @image-url("../assets/ring_bg.png");
            width: 100%;
            height: 100%;
        }

        // 2. Lit progress segments (60 slices)
        for seg[i] in RingData.segments: Image {
            x: seg.x;
            y: seg.y;
            source: seg.img;
            visible: (i / 60.0) <= state.progress_ratio;
        }

        // 3. Round Start Cap (12 o'clock, 22px diameter circle at x: 184px, y: 6px)
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: state.accent;
            x: 184px;
            y: 6px;
            visible: state.progress_ratio > 0.008;
        }

        // 4. Round Tip Cap (22px diameter circle at the leading edge of the active slice)
        Rectangle {
            private property <float> tip_slice: min(59.0, floor(state.progress_ratio * 60.0));
            private property <angle> tip_angle: (self.tip_slice + 1) * 6deg;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: state.accent;
            x: 184px + 178px * sin(self.tip_angle);
            y: 184px - 178px * cos(self.tip_angle);
            visible: state.progress_ratio > 0.008;
        }

        // 5. Upper Deck: Track Title, Artist, Album
        VerticalLayout {
            y: 65px;
            x: (parent.width - 230px) / 2;
            width: 230px;
            height: 85px;
            spacing: 3px;
            alignment: center;

            // Track Title with native Slint Marquee
            MarqueeText {
                width: parent.width;
                height: 30px;
                text: state.track_title != "" ? state.track_title : "No Track";
                text_color: #ffffff;
                font-size: 24px;
                font-weight: 800;
            }

            // Artist Name
            Text {
                width: parent.width;
                text: state.track_artist != "" ? state.track_artist : "Unknown Artist";
                color: #ffffff;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }

            // Album Name
            if state.track_album != "": Text {
                width: parent.width;
                text: state.track_album;
                color: #ffffff;
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        // 6. Center Deck: Audio Equalizer (when playing) or Play Indicator (when paused)
        if state.is_playing: AudioEqualizer {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            bar_color: state.accent;
        }

        if !state.is_playing: Image {
            source: @image-url("../assets/play.png");
            x: 128px;
            y: 106px;
            width: 178px;
            height: 178px;
        }

        if root.DEBUG: TouchArea {
            x: 128px;
            y: 106px;
            width: 178px;
            height: 178px;
            clicked => { root.state.is_playing = !root.state.is_playing; }
        }

        // 7. Lower Deck: Remaining Time
        Text {
            y: 248px;
            width: parent.width;
            text: state.remaining_str != "" ? state.remaining_str : "--:--";
            color: state.accent;
            font-size: 22px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        // 8. Temporary Volume HUD overlay (when volume is changing)
        if state.volume_visible: Rectangle {
            y: 290px;
            x: (parent.width - 130px) / 2;
            width: 130px;
            height: 36px;
            border-radius: 18px;
            background: #12151c;
            border-width: 1.5px;
            border-color: state.accent;

            Text {
                width: parent.width;
                height: parent.height;
                text: "VOL " + state.volume + "%";
                color: #ffffff;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // 9. Navigation hint (when volume HUD is not visible)
        if !state.volume_visible: navigation := Text {
            y: 298px;
            width: parent.width;
            text: "SWIPE UP FOR GROUPS";
            color: white;
            font-size: 14px;
            font-weight: 400;
            horizontal-alignment: center;

            if root.DEBUG: TouchArea {
                clicked => { root.state.mode = 0; }
            }
        }
    }
}
