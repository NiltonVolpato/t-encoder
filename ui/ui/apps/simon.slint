// Simon Says game component.
//
// Designed for the round 390x390 AMOLED: a 380px circular clipped container
// divided into four quadrant pads (Yellow, Blue, Red, Green) with a 6px black
// cross seam, overlaid with a central circular status hub.
//
// The outer circle's `clip: true` rounds the outer corners of the quadrants,
// while the central hub cuts out the inner circle, producing the classic
// annular Simon wedges with pure Rectangle geometry.

export struct SimonState {
    yellow-lit: bool,
    blue-lit: bool,
    red-lit: bool,
    green-lit: bool,
    score: int,
    level: int,
    status: string,
    accent: color,
    show-button: bool,
    button-text: string,
    button-subtext: string,
    button-bg: color,
    button-text-color: color,
}

export component Simon inherits Rectangle {
    in property <SimonState> state;

    background: #000000;

    // Top-Left: Yellow (220 Hz)
    Rectangle {
        x: 0px;
        y: 0px;
        width: 192px;
        height: 192px;
        background: state.yellow-lit ? #ffff20 : #555500;
        animate background { duration: 80ms; }
    }

    // Top-Right: Blue (165 Hz)
    Rectangle {
        x: 198px;
        y: 0px;
        width: 192px;
        height: 192px;
        background: state.blue-lit ? #20a0ff : #003066;
        animate background { duration: 80ms; }
    }

    // Bottom-Left: Red (277 Hz)
    Rectangle {
        x: 0px;
        y: 198px;
        width: 192px;
        height: 192px;
        background: state.red-lit ? #ff2040 : #660510;
        animate background { duration: 80ms; }
    }

    // Bottom-Right: Green (330 Hz)
    Rectangle {
        x: 198px;
        y: 198px;
        width: 192px;
        height: 192px;
        background: state.green-lit ? #30e050 : #0a5515;
        animate background { duration: 80ms; }
    }

    // Center status & score hub.
    Rectangle {
        width: 150px;
        height: 150px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 75px;
        background: #121212;
        border-width: 3px;
        border-color: #262626;

        VerticalLayout {
            alignment: center;
            spacing: 3px;

            Text {
                text: state.status;
                color: #bbbbbb;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: "\{state.score}";
                color: white;
                font-size: 42px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Text {
                text: "LVL \{state.level}";
                color: state.accent;
                font-size: 20px;
                horizontal-alignment: center;
            }
        }
    }

    // Prominent overlay button for START and GAME OVER.
    if state.show-button: Rectangle {
        width: 280px;
        height: 94px;
        x: (parent.width - self.width) / 2 + 8px;
        y: (parent.height - self.height) / 2 + 8px;
        border-radius: 32px;
        background: black;
        border-width: 3px;
        border-color: black;
    }
    if state.show-button: Rectangle {
        width: 280px;
        height: 94px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 32px;
        background: state.button-bg;
        border-width: 3px;
        border-color: white;

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                text: state.button-text;
                color: state.button-text-color;
                font-size: 42px;
                font-weight: 900;
                horizontal-alignment: center;
            }

            if state.button-subtext != "": Text {
                text: state.button-subtext;
                color: state.button-text-color;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }
        }
    }
}
