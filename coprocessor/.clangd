CompileFlags:
  CompilationDatabase: .
  BuiltinHeaders: QueryDriver
  Remove:
    - -mlongcalls
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion

---
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc++-header
    - -std=gnu++26
    - -Iinclude
    - -Isrc
