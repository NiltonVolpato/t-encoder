import { Theme, CircularScreen, AppInfo } from "@theme";

export global MacropadInfo {
    out property <AppInfo> info: {
        name: "Macropad",
        accent: #6366f1,
        icon: @image-url("../assets/macropad.svg"),
    };
}

export component MacropadApp inherits Window {
    title: "Macropad";
    width: Theme.screen-size;
    height: Theme.screen-size;
    background: #6366f1;
    default-font-family: "Inter";

    callback exit();

    forward-focus: dial-focus;
    dial-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.exit();
                return accept;
            }
            reject
        }
    }

    CircularScreen {
        background: #6366f1;

        TouchArea {
            clicked => { root.exit(); }
        }

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: "Macropad";
                color: white;
                font-size: 32px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: "TAP OR ESC TO EXIT";
                color: white.darker(0.2);
                font-size: 14px;
                font-weight: 500;
                horizontal-alignment: center;
                letter-spacing: 1.5px;
            }
        }
    }
}
