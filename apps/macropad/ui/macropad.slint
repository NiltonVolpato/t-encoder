import { AppWindow, Theme, CircularScreen, AppInfo, TextSm, TextXlBold } from "@theme";

export global MacropadInfo {
    out property <AppInfo> info: {
        name: "Macropad",
        accent: #6366f1,
        icon: @image-url("../assets/macropad.svg"),
    };
}

export component MacropadApp inherits AppWindow {
    title: "Macropad";
    background: #6366f1;

    callback exit();

    forward-focus: dial-focus;
    dial-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.exit();
                return accept;
            }
            reject
        }
    }

    CircularScreen {
        background: #6366f1;

        TouchArea {
            clicked => { root.exit(); }
        }

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            TextXlBold {
                text: "Macropad";
                color: white;
                horizontal-alignment: center;
            }

            TextSm {
                text: "TAP OR ESC TO EXIT";
                color: white.darker(0.2);
                horizontal-alignment: center;
                letter-spacing: 1.5px;
            }
        }
    }
}

