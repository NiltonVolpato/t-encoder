import { AppWindow, Theme, CircularScreen, AppInfo, TextSm, TextXlBold } from "@theme";

export global PomodoroInfo {
    out property <AppInfo> info: {
        name: "Pomodoro",
        accent: #ef4444,
        icon: @image-url("../assets/tomato.svg"),
    };
}

export component PomodoroApp inherits AppWindow {
    title: "Pomodoro";
    background: #ef4444;

    callback exit();

    forward-focus: dial-focus;
    dial-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.exit();
                return accept;
            }
            reject
        }
    }

    CircularScreen {
        background: #ef4444;

        TouchArea {
            clicked => { root.exit(); }
        }

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            TextXlBold {
                text: "Pomodoro";
                color: white;
                horizontal-alignment: center;
            }

            TextSm {
                text: "TAP OR ESC TO EXIT";
                color: white.darker(0.2);
                horizontal-alignment: center;
                letter-spacing: 1.5px;
            }
        }
    }
}

