import { AppWindow, Theme, AppInfo, TextBase, TextLgBold, TextDisplayBold } from "@theme";
import { TextBaseBold } from "../../../crates/theme/ui/theme.slint";

export global ClockInfo {
    out property <AppInfo> info: {
        name: "Clock",
        accent: #3b82f6,
        icon: @image-url("../assets/clock.svg"),
    };
}

export component ClockApp inherits AppWindow {
    title: "Clock";

    in-out property <int> hours: 10;
    in-out property <int> minutes: 42;
    in-out property <int> seconds: 35;
    in-out property <string> date-str: "MON, SEP 14";

    callback adjust-minutes(int); // delta
    callback exit();

    forward-focus: dial-focus;

    dial-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.exit();
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.RightArrow {
                root.adjust-minutes(1);
                return accept;
            }
            if event.text == Key.DownArrow || event.text == Key.LeftArrow {
                root.adjust-minutes(-1);
                return accept;
            }
            reject
        }
    }

    // Decorative outer border ring
    Rectangle {
        width: Theme.screen-size - 16px;
        height: Theme.screen-size - 16px;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.surface-variant;
    }

    // Container for seconds indicator arc along outer track
    block := Rectangle {
        private property <float> R: 162.5;
        private property <angle> alpha: root.seconds * 6deg;
        private property <float> center-x: 180.0 + R * sin(alpha);
        private property <float> center-y: 180.0 - R * cos(alpha);

        x: (center-x - 22.0) * 1px;
        y: (center-y - 22.0) * 1px;
        width: 44px;
        height: 44px;

        // The arc itself.
        Path {
            width: 100%;
            height: 100%;
            fit: preserve;
            stroke: Theme.accent;
            stroke-width: 8px;
            stroke-line-cap: butt;

            private property <angle> start-angle: block.alpha - 3.0deg;
            private property <angle> end-angle: block.alpha + 3.0deg;

            MoveTo {
                x: 22.0 + block.R * (sin(start-angle) - sin(block.alpha));
                y: 22.0 - block.R * (cos(start-angle) - cos(block.alpha));
            }
            ArcTo {
                radius-x: block.R;
                radius-y: block.R;
                x: 22.0 + block.R * (sin(end-angle) - sin(block.alpha));
                y: 22.0 - block.R * (cos(end-angle) - cos(block.alpha));
                sweep: true;
                large-arc: false;
            }
        }
    }

    // Inner dial background
    Rectangle {
        width: Theme.screen-size - 50px;
        height: Theme.screen-size - 50px;
        border-radius: self.width / 2;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.surface-variant;
    }

    // Center content layout
    VerticalLayout {
        alignment: center;
        spacing: 16px;

        // Date readout
        TextLgBold {
            text: root.date-str;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            letter-spacing: 1px;
        }

        // Main digital time readout (Hours : Minutes)
        HorizontalLayout {
            alignment: center;
            spacing: 6px;

            TextDisplayBold {
                text: root.hours < 10 ? "0" + root.hours : "" + root.hours;
                color: Theme.text-primary;
                horizontal-alignment: right;
            }

            TextDisplayBold {
                y: -8px;
                text: ":";
                color: Theme.accent;
                horizontal-alignment: center;
            }

            TextDisplayBold {
                text: root.minutes < 10 ? "0" + root.minutes : "" + root.minutes;
                color: Theme.text-primary;
                horizontal-alignment: left;
            }
        }

        // Focus hint for rotary encoder
        if dial-focus.has-focus: TextBaseBold {
            text: "• ROTATE TO ADJUST •";
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
    }
}
