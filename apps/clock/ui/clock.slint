import { AppWindow, Theme, CircularScreen, AppInfo, TextBase, TextLgBold, TextDisplayBold } from "@theme";

export global ClockInfo {
    out property <AppInfo> info: {
        name: "Clock",
        accent: #3b82f6,
        icon: @image-url("../assets/clock.svg"),
    };
}

export component ClockApp inherits AppWindow {
    title: "Clock";

    in-out property <int> hours: 10;
    in-out property <int> minutes: 42;
    in-out property <int> seconds: 35;
    in-out property <string> date-str: "MON, SEP 14";
    in-out property <bool> show-seconds: true;

    callback toggle-seconds();
    callback adjust-minutes(int); // delta
    callback exit();

    forward-focus: dial-focus;

    dial-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.exit();
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.RightArrow {
                root.adjust-minutes(1);
                return accept;
            }
            if event.text == Key.DownArrow || event.text == Key.LeftArrow {
                root.adjust-minutes(-1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.toggle-seconds();
                return accept;
            }
            reject
        }
    }

    CircularScreen {
        TouchArea {
            clicked => { root.toggle-seconds(); }
        }

        // Decorative outer border ring
        Rectangle {
            width: 374px;
            height: 374px;
            border-radius: self.width / 2;
            border-width: 2px;
            border-color: Theme.surface-variant;
        }

        // Inner dial background
        Rectangle {
            width: 340px;
            height: 340px;
            border-radius: self.width / 2;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.surface-variant;
        }

        // Center content layout
        VerticalLayout {
            alignment: center;
            spacing: 16px;

            // Date readout
            TextLgBold {
                text: root.date-str;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                letter-spacing: 1px;
            }

            // Main digital time readout (Hours : Minutes)
            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                TextDisplayBold {
                    text: root.hours < 10 ? "0" + root.hours : "" + root.hours;
                    color: Theme.text-primary;
                    horizontal-alignment: right;
                }

                TextDisplayBold {
                    y: -8px;
                    text: ":";
                    color: Theme.accent;
                    horizontal-alignment: center;
                }

                TextDisplayBold {
                    text: root.minutes < 10 ? "0" + root.minutes : "" + root.minutes;
                    color: Theme.text-primary;
                    horizontal-alignment: left;
                }
            }

            // Seconds badge / mode indicator
            if root.show-seconds: HorizontalLayout {
                padding-bottom: 10px;
                alignment: center;
                Rectangle {
                    border-radius: 12px;
                    background: Theme.surface-variant;
                    horizontal-stretch: 0;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 4px;
                        padding-bottom: 4px;

                        TextLgBold {
                            text: (root.seconds < 10 ? "0" + root.seconds : "" + root.seconds) + "s";
                            color: Theme.accent;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Focus hint for rotary encoder
            if dial-focus.has-focus: TextBase {
                text: "• ROTATE TO ADJUST •";
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }
}
