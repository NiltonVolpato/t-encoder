import { AppWindow, Theme, AppInfo, TextLgBold, TextDisplayBold } from "@theme";

export global ClockInfo {
    out property <AppInfo> info: {
        name: "Clock",
        accent: #3b82f6,
        icon: @image-url("../assets/clock.svg"),
    };
}

export struct ClockTheme {
    time-color: color,
    colon-color: color,
    date-color: color,
    seconds-color: color,
    outer-ring-color: color,
    inner-frame-color: color,
    show-outer-ring: bool,
    show-inner-frame: bool,
    show-seconds-arc: bool,
    show-date: bool,
}

export component ClockApp inherits AppWindow {
    title: "Clock";

    in-out property <int> hours: 10;
    in-out property <int> minutes: 42;
    in-out property <int> seconds: 35;
    in-out property <string> date-str: "MON, SEP 14";

    in property <ClockTheme> theme: {
        time-color: #2D729B,
        colon-color: #2D729B,
        date-color: #97793F,
        seconds-color: #CF3B57,
        outer-ring-color: #586574,
        inner-frame-color: Theme.surface-variant,
        show-outer-ring: false,
        show-inner-frame: false,
        show-seconds-arc: true,
        show-date: true,
    };

    callback adjust-minutes(int); // delta
    callback exit();

    forward-focus: dial-focus;

    dial-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.exit();
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.RightArrow {
                root.adjust-minutes(1);
                return accept;
            }
            if event.text == Key.DownArrow || event.text == Key.LeftArrow {
                root.adjust-minutes(-1);
                return accept;
            }
            reject
        }
    }

    in-out property <image> background-image;

    // Background wallpaper
    if root.background-image.width > 0: Image {
        source: root.background-image;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }

    // Decorative outer border ring
    if root.theme.show-outer-ring: Rectangle {
        width: Theme.screen-size - 16px;
        height: Theme.screen-size - 16px;
        border-radius: self.width / 2;
        border-width: 18px;
        border-color: root.theme.outer-ring-color;
    }

    // Container for seconds indicator arc along outer track
    if root.theme.show-seconds-arc: block := Rectangle {
        private property <float> R: 163;
        private property <angle> alpha: root.seconds * 6deg;
        private property <float> center-x: 180.0 + R * sin(alpha);
        private property <float> center-y: 180.0 - R * cos(alpha);

        x: (center-x - 22.0) * 1px;
        y: (center-y - 22.0) * 1px;
        width: 44px;
        height: 44px;

        // The arc itself.
        Path {
            width: 100%;
            height: 100%;
            fit: preserve;
            stroke: root.theme.seconds-color;
            stroke-width: 14px;
            stroke-line-cap: butt;

            private property <angle> start-angle: block.alpha - 3.0deg;
            private property <angle> end-angle: block.alpha + 3.0deg;

            MoveTo {
                x: 22.0 + block.R * (sin(start-angle) - sin(block.alpha));
                y: 22.0 - block.R * (cos(start-angle) - cos(block.alpha));
            }
            ArcTo {
                radius-x: block.R;
                radius-y: block.R;
                x: 22.0 + block.R * (sin(end-angle) - sin(block.alpha));
                y: 22.0 - block.R * (cos(end-angle) - cos(block.alpha));
                sweep: true;
                large-arc: false;
            }
        }
    }

    // Inner dial frame
    if root.theme.show-inner-frame: Rectangle {
        width: Theme.screen-size - 50px;
        height: Theme.screen-size - 50px;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: root.theme.inner-frame-color;
    }

    // Date readout positioned along the equal-area line of the upper semicircle:
    // In Cartesian coordinates: y = d * R above center (d ≈ 0.40397).
    // In screen coordinates: y = R * (1 - d) = root.height * 0.5 * (1 - 0.40397) ≈ root.height * 0.298
    if root.theme.show-date: TextLgBold {
        y: root.height * 0.5 * (1.0 - 0.40397) - self.height / 2;
        width: 100%;
        text: root.date-str;
        color: root.theme.date-color;
        horizontal-alignment: center;
        letter-spacing: 1px;
    }

    // Main digital time readout (Hours : Minutes) centered vertically
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        y: (root.height - self.height) / 2;
        height: 72px;

        TextDisplayBold {
            text: root.hours < 10 ? "0" + root.hours : "" + root.hours;
            color: root.theme.time-color;
            horizontal-alignment: right;
        }

        TextDisplayBold {
            y: -8px;
            text: ":";
            color: root.theme.colon-color;
            horizontal-alignment: center;
        }

        TextDisplayBold {
            text: root.minutes < 10 ? "0" + root.minutes : "" + root.minutes;
            color: root.theme.time-color;
            horizontal-alignment: left;
        }
    }
}
