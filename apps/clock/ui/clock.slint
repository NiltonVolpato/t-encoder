import { AppWindow, Theme, CircularScreen, AppInfo, TextBase, TextLgBold, TextDisplayBold } from "@theme";
import { TextBaseBold } from "../../../crates/theme/ui/theme.slint";

export global ClockInfo {
    out property <AppInfo> info: {
        name: "Clock",
        accent: #3b82f6,
        icon: @image-url("../assets/clock.svg"),
    };
}

export component ClockApp inherits AppWindow {
    title: "Clock";

    in-out property <int> hours: 10;
    in-out property <int> minutes: 42;
    in-out property <int> seconds: 35;
    in-out property <string> date-str: "MON, SEP 14";

    callback adjust-minutes(int); // delta
    callback exit();

    forward-focus: dial-focus;

    dial-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.exit();
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.RightArrow {
                root.adjust-minutes(1);
                return accept;
            }
            if event.text == Key.DownArrow || event.text == Key.LeftArrow {
                root.adjust-minutes(-1);
                return accept;
            }
            reject
        }
    }

    CircularScreen {
        // Decorative outer border ring
        Rectangle {
            width: Theme.screen-size - 16px;
            height: Theme.screen-size - 16px;
            border-radius: self.width / 2;
            border-width: 2px;
            border-color: Theme.surface-variant;
        }

        // 6º moving seconds arc indicator along outer ring
        Path {
            width: 100%;
            height: 100%;
            stroke: Theme.accent;
            stroke-width: 4px;
            stroke-line-cap: round;
            viewbox-width: self.width / 1px - self.stroke-width / 1px;
            viewbox-height: self.height / 1px - self.stroke-width / 1px;
            viewbox-x: -self.viewbox-width / 2;
            viewbox-y: -self.viewbox-height / 2;

            private property <float> R: (Theme.screen-size / 1px - 16) / 2;
            private property <angle> alpha: root.seconds * 6deg;
            private property <angle> start-angle: alpha - 3deg;
            private property <angle> end-angle: alpha + 3deg;

            MoveTo {
                x: R * sin(start-angle);
                y: -R * cos(start-angle);
            }
            ArcTo {
                radius-x: R;
                radius-y: R;
                x: R * sin(end-angle);
                y: -R * cos(end-angle);
                sweep: true;
                large-arc: false;
            }
        }

        // Inner dial background
        Rectangle {
            width: Theme.screen-size - 50px;
            height: Theme.screen-size - 50px;
            border-radius: self.width / 2;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.surface-variant;
        }

        // Center content layout
        VerticalLayout {
            alignment: center;
            spacing: 16px;

            // Date readout
            TextLgBold {
                text: root.date-str;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                letter-spacing: 1px;
            }

            // Main digital time readout (Hours : Minutes)
            HorizontalLayout {
                alignment: center;
                spacing: 6px;

                TextDisplayBold {
                    text: root.hours < 10 ? "0" + root.hours : "" + root.hours;
                    color: Theme.text-primary;
                    horizontal-alignment: right;
                }

                TextDisplayBold {
                    y: -8px;
                    text: ":";
                    color: Theme.accent;
                    horizontal-alignment: center;
                }

                TextDisplayBold {
                    text: root.minutes < 10 ? "0" + root.minutes : "" + root.minutes;
                    color: Theme.text-primary;
                    horizontal-alignment: left;
                }
            }

            // Focus hint for rotary encoder
            if dial-focus.has-focus: TextBaseBold {
                text: "• ROTATE TO ADJUST •";
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }
}
