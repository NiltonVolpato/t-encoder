// P2 spike UI: a deliberately close mock of the embedded-graphics launcher, so
// the flash/RAM/frame-time comparison is like-for-like rather than comparing a
// rich Slint scene against a plain one.

export component LauncherUI inherits Window {
    in property <int> selected: 0;

    width: 390px;
    height: 390px;
    background: #000000;

    // Focal card.
    Rectangle {
        x: 105px;
        y: 95px;
        width: 180px;
        height: 200px;
        border-radius: 24px;
        background: #0a2418;
        border-width: 3px;
        border-color: #2ea36b;

        Rectangle {
            x: 46px;
            y: 28px;
            width: 88px;
            height: 88px;
            border-radius: 44px;
            background: #2ea36b;
        }

        Text {
            x: 0px;
            y: 150px;
            width: 180px;
            text: "Toggles";
            color: #ffffff;
            horizontal-alignment: center;
        }
    }

    // Neighbour peeking in at the rim.
    Rectangle {
        x: 315px;
        y: 95px;
        width: 180px;
        height: 200px;
        border-radius: 24px;
        background: #06110c;
        border-width: 1px;
        border-color: #123f2a;
    }
}
