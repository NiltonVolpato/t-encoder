
import "../assets/fonts/InterVariable.ttf";

export global Theme {
    out property <string> font-family: "Inter Variable";
    in-out property <length> screen-size: 360px;
    in-out property <length> screen-radius: 180px;

    out property <color> background: #000000; // True black on AMOLED display.
    out property <color> surface: #111827;
    out property <color> surface-variant: #1e293b;
    out property <color> accent: #38bdf8;
    out property <color> accent-alt: #f43f5e;
    out property <color> text-primary: #f8fafc;
    out property <color> text-secondary: #94a3b8;
    out property <color> text-muted: #475569;
    out property <color> focus: #38bdf8;
}

export struct AppInfo {
    name: string,
    accent: color,
    icon: image,
}

export component TextSm inherits Text { font-family: "Inter Variable"; font-size: 14px; font-weight: 400; }
export component TextBase inherits Text { font-family: "Inter Variable"; font-size: 16px; font-weight: 400; }
export component TextBaseBold inherits Text { font-family: "Inter Variable"; font-size: 16px; font-weight: 700; }
export component TextLgBold inherits Text { font-family: "Inter Variable"; font-size: 20px; font-weight: 700; }
export component TextXlBold inherits Text { font-family: "Inter Variable"; font-size: 26px; font-weight: 700; }
export component TextDisplayBold inherits Text { font-family: "Inter Variable"; font-size: 72px; font-weight: 700; }

export component CircularScreen inherits Rectangle {
    width: Theme.screen-size;
    height: Theme.screen-size;
    background: Theme.background;
}

export component RotaryKnob inherits FocusScope {
    in-out property <int> value: 0;
    in property <int> min: 0;
    in property <int> max: 100;
    in property <int> step: 1;
    in property <length> size: 140px;
    in property <string> label: "";
    in property <string> unit: "";

    callback value-changed(int);
    callback activated();

    width: root.size;
    height: root.size;
    focus-on-tab-navigation: true;

    accessible-role: slider;
    accessible-value: root.value;
    accessible-action-increment => {
        root.increment();
    }
    accessible-action-decrement => {
        root.decrement();
    }
    accessible-action-default => {
        root.activated();
    }

    public function increment() {
        if root.value + root.step <= root.max {
            root.value += root.step;
            root.value-changed(root.value);
        }
    }

    public function decrement() {
        if root.value - root.step >= root.min {
            root.value -= root.step;
            root.value-changed(root.value);
        }
    }

    key-pressed(event) => {
        if event.text == Key.UpArrow || event.text == Key.RightArrow {
            root.increment();
            return accept;
        }
        if event.text == Key.DownArrow || event.text == Key.LeftArrow {
            root.decrement();
            return accept;
        }
        if event.text == Key.Return || event.text == " " {
            root.activated();
            return accept;
        }
        reject
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        background: Theme.background;
        border-width: root.has-focus ? 3px : 1px;
        border-color: root.has-focus ? Theme.focus : Theme.surface-variant;

        animate border-color { duration: 150ms; }
        animate border-width { duration: 150ms; }

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            if root.label != "": TextSm {
                text: root.label;
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }

            TextXlBold {
                text: root.value + (root.unit != "" ? " " + root.unit : "");
                color: root.has-focus ? Theme.accent : Theme.text-primary;
                horizontal-alignment: center;
            }
        }
    }
}

export global Navigation {
    callback back() -> bool;
    callback quit() -> bool;
    callback exit();

    public function trigger-back() {
        if !self.back() {
            self.exit();
        }
    }

    public function trigger-quit() {
        if !self.quit() {
            self.exit();
        }
    }
}

// IMPORTANT: Keep this as the last exported element, so Slint use a reasonable default font.
export component AppWindow inherits Window {
    width: Theme.screen-size;
    height: Theme.screen-size;
    background: #000000;  // True black on AMOLED display.
    default-font-family: "Inter Variable";
    default-font-size: 16px;
    default-font-weight: 400;

    in-out property <bool> enable-gestures: true;

    // 0: None, 1: Left-to-Right (Back), 2: Right-to-Left (Back), 3: Bottom-to-Top (Quit)
    private property <int> active-edge: 0;
    private property <length> drag-dist: 0px;

    @children

    // Gesture feedback: circle arrow indicator (similar to Android back/home gesture)
    Image {
        source: root.active-edge == 1 ? @image-url("../assets/arrow-circle-right.svg") :
                root.active-edge == 2 ? @image-url("../assets/arrow-circle-left.svg") :
                @image-url("../assets/arrow-circle-up.svg");
        width: 45px;
        height: 45px;
        image-fit: contain;

        x: root.active-edge == 1 ? 16px + Math.min(24px, root.drag-dist * 0.15) :
           root.active-edge == 2 ? Theme.screen-size - 45px - 16px - Math.min(24px, root.drag-dist * 0.15) :
           (Theme.screen-size - 45px) / 2;

        y: root.active-edge == 3 ? Theme.screen-size - 45px - 16px - Math.min(24px, root.drag-dist * 0.15) :
           (Theme.screen-size - 45px) / 2;

        visible: root.active-edge != 0 && root.drag-dist > 15px;
    }

    // Left Edge TouchArea (0px to 45px, middle vertical region)
    if root.enable-gestures: TouchArea {
        x: 0px;
        y: 60px;
        width: 45px;
        height: Theme.screen-size - 120px;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.active-edge = 1;
                root.drag-dist = 0px;
            }
            if event.button == PointerEventButton.left && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if root.active-edge == 1 {
                    if root.drag-dist >= Theme.screen-size * 0.9 {
                        Navigation.trigger-back();
                    }
                    root.active-edge = 0;
                    root.drag-dist = 0px;
                }
            }
        }

        moved => {
            if self.enabled && self.pressed && root.active-edge == 1 {
                let d = self.mouse-x - self.pressed-x;
                root.drag-dist = Math.max(0px, Math.min(Theme.screen-size, d));
            }
        }
    }

    // Right Edge TouchArea (middle vertical region)
    if root.enable-gestures: TouchArea {
        x: Theme.screen-size - 45px;
        y: 60px;
        width: 45px;
        height: Theme.screen-size - 120px;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.active-edge = 2;
                root.drag-dist = 0px;
            }
            if event.button == PointerEventButton.left && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if root.active-edge == 2 {
                    if root.drag-dist >= Theme.screen-size * 0.9 {
                        Navigation.trigger-back();
                    }
                    root.active-edge = 0;
                    root.drag-dist = 0px;
                }
            }
        }

        moved => {
            if self.enabled && self.pressed && root.active-edge == 2 {
                let d = self.pressed-x - self.mouse-x;
                root.drag-dist = Math.max(0px, Math.min(Theme.screen-size, d));
            }
        }
    }

    // Bottom Edge TouchArea (middle horizontal region)
    if root.enable-gestures: TouchArea {
        x: 60px;
        y: Theme.screen-size - 45px;
        width: Theme.screen-size - 120px;
        height: 45px;

        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.active-edge = 3;
                root.drag-dist = 0px;
            }
            if event.button == PointerEventButton.left && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if root.active-edge == 3 {
                    if root.drag-dist >= Theme.screen-size * 0.9 {
                        Navigation.trigger-quit();
                    }
                    root.active-edge = 0;
                    root.drag-dist = 0px;
                }
            }
        }

        moved => {
            if self.enabled && self.pressed && root.active-edge == 3 {
                let d = self.pressed-y - self.mouse-y;
                root.drag-dist = Math.max(0px, Math.min(Theme.screen-size, d));
            }
        }
    }

    // Force Slint's idiosyncratic MCU font embedder to include reasonable default font and glyphs.
    TextBase { visible: false; width: 0px; height: 0px; text: "ABC"; }
}
